config_version=5

[application]

config/name="MGames Metroidvania"
run/main_scene="uid://dah2f0n5ko78"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

SceneManager="*res://Global/SceneManager/scene_manager.tscn"
SaveManager="*res://Global/save_manager.gd"
MessageBus="*res://Global/message_bus.gd"
PlayerHud="*res://Global/PlayerHUD/player_hud.tscn"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[global_group]

Player=""

